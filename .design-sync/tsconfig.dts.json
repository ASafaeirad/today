{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "outDir": "../dist/types",
    "rootDir": "../src"
  },
  "include": ["../src/ui"],
  "exclude": ["../src/ui/**/*.stories.tsx"]
}
